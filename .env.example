# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore -- it will never be committed.

# MongoDB Atlas connection string. Atlas's own "Download .env file" button
# gives you this in the right format already -- just copy the MONGODB_URI
# line out of that download into here (or rename their file to .env.local
# directly and merge the other variables below into it).
MONGODB_URI=

# Gemini API key, from https://aistudio.google.com/apikey -- powers the
# "Ask Cosmos" chat widget on the storefront.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash (see lib/gemini.js) if left blank --
# only set this if you want to try a different Gemini model.
GEMINI_MODEL=

# Any long random string -- used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Powers the admin "Upload photos" field on the product form. Create a Blob
# store in your Vercel project: dashboard -> your project -> Storage ->
# Create -> Blob. It'll show you this token (or find it again under
# Storage -> your store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Optional -- powers the customer order-status emails sent when an admin
# changes an order's status (lib/email.js). An order without a customer
# email just skips the email; leaving this blank does the same (skips
# every email, logs a warning) rather than breaking the status update.
# Get a key at https://resend.com/api-keys (free tier is enough here).
RESEND_API_KEY=

# Optional. Defaults to Resend's shared "onboarding@resend.dev" test
# address, which works without verifying a domain but looks exactly like
# what it is -- a test address. Once a real domain (e.g. cosmosscents.com)
# is verified in the Resend dashboard, set this to something like
# "Cosmos Scents <orders@cosmosscents.com>".
RESEND_FROM_EMAIL=
