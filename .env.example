# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore -- it will never be committed.

# MongoDB Atlas connection string. Atlas's own "Download .env file" button
# gives you this in the right format already -- just copy the MONGODB_URI
# line out of that download into here (or rename their file to .env.local
# directly and merge the other variables below into it).
MONGODB_URI=

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any long random string -- used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
